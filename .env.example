# ── Vite build-time env (exposed to browser) ──
# Sanity CMS
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Canonical site URL — used for JSON-LD, canonical links, OG tags
VITE_SITE_URL=https://advocateofshalom.com

# Sentry error tracking (optional — leave blank to disable Sentry entirely)
VITE_SENTRY_DSN=
# One of: "production", "staging", "development". Falls back to Vite's MODE
# when unset. Set per Netlify context so staging errors don't pollute prod.
VITE_SENTRY_ENV=

# ── Sentry source map upload (build-time only, NOT exposed to browser) ──
# Optional — leave SENTRY_AUTH_TOKEN blank to disable source map upload
# entirely (build still succeeds, just with minified stack traces in Sentry).
# When set, Vite generates source maps, uploads them to Sentry, and deletes
# them from dist/ so they aren't publicly served.
# Auth token: Sentry → Settings → Auth Tokens → create token with scopes
# `project:releases`, `project:read`, `org:read`.
SENTRY_AUTH_TOKEN=
# Org slug (Sentry → Settings → Organization → General shows the slug)
SENTRY_ORG=
# Project slug (visible in the URL when viewing a project in Sentry)
SENTRY_PROJECT=

# ── Netlify Functions scope (server-side, NOT exposed to browser) ──
# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=navigator@advocateofshalom.com
CONTACT_FROM_EMAIL=no-reply@advocateofshalom.com

# Sanity Studio "Deploy Site" button
# The secret must match SANITY_STUDIO_DEPLOY_HOOK_SECRET in studio/.env
DEPLOY_HOOK_SECRET=
# Netlify build hook URLs — get these from Netlify → Build hooks
NETLIFY_DEPLOY_HOOK_URL=
NETLIFY_STAGING_DEPLOY_HOOK_URL=

# Sentry error tracking for Netlify Functions (server-side, NOT VITE_ prefixed)
# Same DSN as VITE_SENTRY_DSN — Sentry routes events by DSN, not by scope.
# Leave blank to disable Sentry inside functions (they just log to console).
SENTRY_DSN=
# Tags backend events with an environment name in the Sentry dashboard —
# keep in sync with VITE_SENTRY_ENV per Netlify context.
SENTRY_ENVIRONMENT=
